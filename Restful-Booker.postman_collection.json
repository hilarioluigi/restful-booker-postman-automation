      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseJson = pm.response.json();\r",
              "const variables = pm.environment;\r",
              "\r",
              "pm.environment.set('bookingid', responseJson.bookingid)\r",
              "\r",
              "pm.test('Check response attribute', () => {\r",
              "    pm.expect(responseJson.bookingid).to.exist;\r",
              "    pm.expect(responseJson.booking).to.exist\r",
              "    pm.expect(responseJson.booking.firstname).to.exist\r",
              "    pm.expect(responseJson.booking.lastname).to.exist\r",
              "    pm.expect(responseJson.booking.totalprice).to.exist\r",
              "    pm.expect(responseJson.booking.depositpaid).to.exist\r",
              "    pm.expect(responseJson.booking.bookingdates).to.exist\r",
              "    pm.expect(responseJson.booking.bookingdates.checkin).to.exist\r",
              "    pm.expect(responseJson.booking.bookingdates.checkout).to.exist\r",
              "    pm.expect(responseJson.booking.additionalneeds).to.exist\r",
              "});\r",
              "\r",
              "pm.test('Check response data', () => {\r",
              "    pm.expect(responseJson.booking.firstname).to.eql(variables.get('firstname'));\r",
              "    pm.expect(responseJson.booking.lastname).to.eql(variables.get('lastname'));\r",
              "    pm.expect(responseJson.booking.totalprice).to.eql(JSON.parse(variables.get('totalprice')));\r",
              "    pm.expect(responseJson.booking.depositpaid).to.eql(JSON.parse(variables.get('depositpaid')));\r",
              "    pm.expect(responseJson.booking.bookingdates.checkin).to.eql(variables.get('checkin'));\r",
              "    pm.expect(responseJson.booking.bookingdates.checkout).to.eql(variables.get('checkout'));\r",
              "    pm.expect(responseJson.booking.additionalneeds).to.eql(variables.get('additionalneeds'));\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const env = pm.environment;\r",
              "const replaceIn = pm.variables.replaceIn;\r",
              "const moment = require('moment'); // Import moment.js library for date manipulation\r",
              "\r",
              "env.set('firstname', replaceIn('{{$randomFirstName}}'));\r",
              "env.set('lastname', replaceIn('{{$randomLastName}}'));\r",
              "env.set('totalprice', replaceIn('{{$randomInt}}'));\r",
              "env.set('depositpaid', replaceIn('{{$randomBoolean}}'));\r",
              "env.set('checkin', moment().format(\"YYYY-MM-DD\"));\r",
              "env.set('checkout', moment().add(3, 'days').format(\"YYYY-MM-DD\"));\r",
              "env.set('additionalneeds', replaceIn('{{$randomWords}}'));\r",
              ""
            ],
